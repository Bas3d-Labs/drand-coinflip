# --- server only (never NEXT_PUBLIC_) ---
# Relayer signer. Throwaway testnet key funded from https://faucet.testnet.chain.robinhood.com/
# Leave unset to disable server-side settlement; users can still Reveal from their own wallet.
RELAYER_PRIVATE_KEY=
# Protects /api/sweep. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Optional private RPC for the relayer
RELAYER_RPC_URL=

# --- public ---
# Override the contract address (otherwise src/config/deployments.json)
NEXT_PUBLIC_COINFLIP_ADDRESS=
# Dev only (ignored in production builds): local anvil fork + wallet-less burner connector
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_DEV_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
